{
  "default_permissions": {
    "allow_read_workspace": true,
    "allow_write_workspace": false,
    "allow_network": false,
    "allow_command": false,
    "allow_shell_command": false,
    "allow_mcp": false
  },
  "risk_policy": {
    "low": "allow",
    "medium": "allow",
    "high": "confirm",
